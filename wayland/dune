(rule
 (action
  (progn
   (copy ../stubs/key.h key.h)
   (copy ../stubs/button.h button.h)
   (copy ../stubs/modifier.h modifier.h)
   (copy ../stubs/ml_egl.h ml_egl.h)
   (copy ../stubs/ml_egl_platform.h ml_egl_platform.h))))

(rule
 (target xdg-shell-client-protocol.h)
 (enabled_if %{read:../config/has_wayland})
 (deps (universe))
 (action
  (bash
   "wayland-scanner client-header \
    $(pkg-config --variable=pkgdatadir wayland-protocols)/stable/xdg-shell/xdg-shell.xml \
    %{target}")))

(rule
 (target xdg-shell-protocol.c)
 (enabled_if %{read:../config/has_wayland})
 (deps (universe))
 (action
  (bash
   "wayland-scanner private-code \
    $(pkg-config --variable=pkgdatadir wayland-protocols)/stable/xdg-shell/xdg-shell.xml \
    %{target}")))

(rule
 (target c_flags.sexp)
 (action
  (with-stdout-to %{target}
    (bash
     "pkg-config --cflags wayland-client wayland-egl egl xkbcommon |
      awk 'BEGIN { printf \"(\" } { for(i=1;i<=NF;i++) printf \"\\\"%s\\\" \", $i } END { printf \")\\n\" }'"))))

(rule
 (target l_flags.sexp)
 (action
  (with-stdout-to %{target}
    (bash
     "pkg-config --libs wayland-client wayland-egl egl xkbcommon |
      awk 'BEGIN { printf \"(\" } { for(i=1;i<=NF;i++) printf \"\\\"%s\\\" \", $i } END { printf \")\\n\" }'"))))

(library
 (name gles3_wayland)
 (public_name gles3-wayland)
 (implements gles3)
 (synopsis "OpenGL ES 3 bindings, Wayland platform")
 (flags (:standard -w -6-27-32 -thread))
 (ocamlopt_flags (:standard -O3))
 (enabled_if %{read:../config/has_wayland})
 (c_library_flags (:standard (:include l_flags.sexp)))
 (foreign_stubs (language c)
   (names ml_egl_wayland xdg-shell-protocol)
   (flags (:standard (:include c_flags.sexp)))))
