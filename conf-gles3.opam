# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
version: "3.0"
synopsis: "OpenGL ES3, Commen Egl conf package"
maintainer: ["Christophe" "Raffalli"]
authors: ["Christophe" "Raffalli"]
license: "MIT"
homepage: "https://raffalli.eu/gles3/"
doc: "https://raffalli.eu/gles3"
bug-reports: "https://github.com/craff/gles3/issues"
depends: [
  "dune" {>= "3.20"}
  "conf-pkg-config"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/craff/gles3.git"
x-maintenance-intent: ["(latest)"]
depexts: [
  ["libgles2-mesa-dev"] {os-family = "debian"}
  ["libgles2-mesa-dev"] {os-family = "ubuntu"}
  ["mesa-libGLES-devel"] {os-family = "fedora"}
  ["mesa-libGLES-devel"] {os-family = "centos"}
  ["mesa-libGLES-devel"] {os-family = "rhel"}
  ["Mesa-libGLESv2-devel" "Mesa-libGLESv3-devel"] {os-family = "suse" | os-family = "opensuse"}
  ["mesa-dev"] {os-family = "alpine"}
  ["mesa"] {os-family = "arch"}
  ["mesa-libs"] {os = "freebsd"}
  # OpenBSD includes it in xbase.tgz
  ["MesaLib"] {os = "netbsd"}
  ["mesa"] {os = "macos"}
]
